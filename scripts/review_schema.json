{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "risk",
    "verdict",
    "summary",
    "resolved"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body",
          "priority",
          "confidence",
          "file",
          "line_start",
          "line_end",
          "pre_existing",
          "repro",
          "confirmed"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "80자 이내 한 줄 요약"
          },
          "body": {
            "type": "string",
            "description": "왜 문제인지와 구체적 수정안"
          },
          "priority": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "description": "REVIEW.md 심각도 P0-P3"
          },
          "confidence": {
            "type": "number",
            "description": "0-1"
          },
          "file": {
            "type": "string",
            "description": "저장소 루트 기준 상대 경로"
          },
          "line_start": {
            "type": "integer"
          },
          "line_end": {
            "type": "integer"
          },
          "pre_existing": {
            "type": "boolean",
            "description": "이 diff 이전부터 있던 문제면 true"
          },
          "repro": {
            "type": "string",
            "description": "실패를 보이는 방법(테스트, 명령, 입력). 모르면 빈 문자열"
          },
          "confirmed": {
            "type": "boolean",
            "description": "코드나 실행으로 직접 확인했으면 true, 추정이면 false"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "axes"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "description": "0-100, axes 합계"
        },
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "security",
            "scope",
            "breaking",
            "tests",
            "migration"
          ],
          "properties": {
            "security": {
              "type": "integer",
              "description": "0-30"
            },
            "scope": {
              "type": "integer",
              "description": "0-20"
            },
            "breaking": {
              "type": "integer",
              "description": "0-20"
            },
            "tests": {
              "type": "integer",
              "description": "0-15"
            },
            "migration": {
              "type": "integer",
              "description": "0-15"
            }
          }
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "patch is correct",
        "patch is incorrect"
      ]
    },
    "summary": {
      "type": "string",
      "description": "변경 요약, 남은 위험, 어디까지 확인했는지 2-3문장"
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "검증 리뷰에서 고쳐졌음을 확인한 이전 지적 번호. 첫 리뷰는 빈 배열."
    }
  }
}
